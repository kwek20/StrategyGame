/* Shared vertical main/pause menu layout. */
.menu-panel {
    position: absolute;
    left: 2.5%;
    top: 5%;
    width: 40%;
    height: 90%;
    pointer-events: auto;
}
.menu-content {
    position: absolute;
    left: 13%;
    right: 13%;
    display: flex;
    flex-direction: column;
}
.menu-stack { display: flex; flex-direction: column; flex: 1; }
.menu-item { font-weight: 700; left: 0; }
.menu-stack .danger { margin-top: auto; }

.menu-stack { min-height: 0; }
.menu-panel .button-icon { width: 3.5vh; height: 3.5vh; flex: 0 0 3.5vh; }
