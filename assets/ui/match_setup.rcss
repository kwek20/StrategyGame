body {
    width: 100%;
    height: 100%;
    margin: 0;
    color: #eef5db;
    font-family: "Segoe UI";
    pointer-events: none;
}
#shell {
    position: absolute;
    left: 5%;
    top: 3%;
    width: 90%;
    height: 94%;
    pointer-events: auto;
    animation: .35s quadratic-out enter;
}
.panel-art {
    position: absolute;
    width: 100%;
    height: 100%;
    image-color: #e2e8ea;
    pointer-events: none;
}
#content {
    position: absolute;
    left: 15%;
    right: 15%;
    top: 12%;
    bottom: 10%;
    display: flex;
    flex-direction: column;
}
h1 {
    margin: 0;
    height: 40dp;
    font-size: 31dp;
    color: #fff9d0;
}
#match-mode {
    height: 22dp;
    color: #9fc9d5;
    font-size: 14dp;
}
.rule {
    height: 2dp;
    background-color: #1da6c9;
    margin-bottom: 12dp;
}
.columns {
    display: flex;
    gap: 5%;
    flex: 1;
}
.left-column {
    width: 46%;
    display: flex;
    flex-direction: column;
}
.right-column {
    width: 49%;
    display: flex;
    flex-direction: column;
}
h2 {
    margin: 1dp 0 6dp;
    color: #62d9f4;
    font-size: 18dp;
}
.option {
    height: 70dp;
}
.option.compact {
    height: 63dp;
}
.label {
    display: block;
    height: 18dp;
    color: #aec8d0;
    font-size: 12dp;
}
.seed-row {
    height: 48dp;
    display: flex;
    gap: 10dp;
}
.seed-row button:first-child {
    width: 42%;
}
.seed-row button:last-child {
    flex: 1;
}
button {
    border-width: 0;
    background-color: #081116;
    color: #f2f8dd;
    font-weight: 700;
    cursor: pointer;
}
button:hover, button:focus {
    background-color: #12313a;
    outline: 2dp #28b6d2;
}
#summary {
    height: 250dp;
    margin-top: 18dp;
    padding: 12dp;
    background-color: #03080c;
    border: 2dp #172d36;
}
.summary-body {
    display: flex;
}
.summary-list {
    width: 55%;
}
.summary-row {
    height: 38dp;
    display: flex;
    align-items: center;
    font-size: 12dp;
}
.summary-row img,.dot {
    width: 30dp;
    height: 30dp;
    margin-right: 9dp;
}
.dot {
    height: auto;
    color: #31c6df;
    text-align: center;
}
.preview {
    width: 45%;
    display: flex;
    flex-direction: column;
    align-items: center;
}
.preview img {
    width: 150dp;
    height: 145dp;
    border: 2dp #24aaca;
}
.preview span {
    font-size: 11dp;
    color: #92bdc8;
    margin-top: 4dp;
}
.actions {
    height: 48dp;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
}
.actions button {
    width: 205dp;
    height: 43dp;
    font-size: 15dp;
}
.actions .start {
    color: #dfffca;
}
.actions .danger {
    color: #ffd7cf;
}
@keyframes enter {
    from {
        opacity: 0;
        top: 6%;
    }
    to {
        opacity: 1;
        top: 3%;
    }
}
