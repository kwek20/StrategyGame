body {
    color: #eef5db;
}
#shell {
    left: 5%;
    top: 3%;
    width: 90%;
    height: 94%;
    animation: .35s quadratic-out match_setup-enter;
}

h1 {
    margin: 0;
    height: 40dp;
    font-size: 31dp;
    color: #fff9d0;
}
#match-mode {
    height: 22dp;
    color: #9fc9d5;
    font-size: 14dp;
}
.rule {
    margin-bottom: 12dp;
}

.left-column {
    width: 46%;
}
.right-column {
    width: 49%;
}
h2 {
    margin: 1dp 0 6dp;
    color: #62d9f4;
    font-size: 18dp;
}
.option {
    height: 70dp;
}
.option.compact {
    height: 63dp;
}
.label {
    display: block;
    height: 18dp;
    color: #aec8d0;
    font-size: 12dp;
}
.seed-row {
    height: 48dp;
    display: flex;
    gap: 10dp;
}
.seed-row button:first-child {
    width: 42%;
}
.seed-row button:last-child {
    flex: 1;
}
button {
    color: #f2f8dd;
    font-weight: 700;
}

#summary {
    height: 250dp;
    margin-top: 18dp;
    padding: 12dp;
    background-color: #03080c;
    border: 2dp #172d36;
}
.summary-body {
    display: flex;
}
.summary-list {
    width: 55%;
}
.summary-row {
    height: 38dp;
    display: flex;
    align-items: center;
    font-size: 12dp;
}
.summary-row img,.dot {
    width: 30dp;
    height: 30dp;
    margin-right: 9dp;
}
.dot {
    height: auto;
    color: #31c6df;
    text-align: center;
}
.preview {
    width: 45%;
    display: flex;
    flex-direction: column;
    align-items: center;
}
.preview img {
    width: 150dp;
    height: 145dp;
    border: 2dp #24aaca;
}
.preview span {
    font-size: 11dp;
    color: #92bdc8;
    margin-top: 4dp;
}
.actions {
    align-items: center;
    margin-top: auto;
}

@keyframes match_setup-enter {
    from {
        opacity: 0;
        top: 6%;
    }
    to {
        opacity: 1;
        top: 3%;
    }
}
