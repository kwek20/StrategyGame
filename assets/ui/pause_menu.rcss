body {
    color: #f2f8dc;
}
#pause-dim {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: #000000;
    opacity: .42;
}
#pause-shell {
    animation: .28s quadratic-out pause_menu-enter;
}
#pause-panel-art {
    image-color: #e3e9eb;
}
#pause-content {
    top: 14%;
    bottom: 14%;
}
#pause-title {
    height: 55dp;
    margin: 0;
    color: #fff8cb;
    font-size: 38dp;
}
#pause-rule {
    margin-bottom: 32dp;
}
#pause-buttons {
    gap: 20dp;
}
.pause-button {
    width: 100%;
    height: 68dp;
    color: #eef7dc;
    font-size: 24dp;
    transition: left .12s quadratic-out;
}
.pause-button:hover,.pause-button:focus {
    left: 6dp;
}
.primary {
    color: #ddffca;
}
.danger {
    color: #ffd6ce;
}
@keyframes pause_menu-enter {
    from {
        opacity: 0;
        left: 1%;
    }
    to {
        opacity: 1;
        left: 2.5%;
    }
}
