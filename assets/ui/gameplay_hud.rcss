body {
    color: #eef5dd;
}
.panel-art {
    image-color: #e5ebec;
}
button {
    border-width: 0;
    background-color: #071116;
    color: #eff7dd;
    cursor: pointer;
}
button:hover, button:focus {
    background-color: #12323b;
    outline: 2dp #2ac4df;
}
#top-shell {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 4.5vh;
    min-height: 48dp;
    background-color: #07171ef2;
    border-bottom: 1dp #249bb7;
    pointer-events: auto;
}
#resources-content {
    position: absolute;
    left: 2.5%;
    right: 190dp;
    top: 10%;
    height: 80%;
    display: flex;
    gap: 1.4%;
    align-items: center;
}
#stockpile-resources {
    display: flex;
    align-items: center;
    gap: 1.4vw;
}
.resource {
    height: 100%;
    display: flex;
    align-items: center;
    gap: .35vw;
    font-size: 12dp;
    font-weight: 700;
}
.resource img {
    width: 2.2vh;
    height: 2.2vh;
    min-width: 26dp;
    min-height: 26dp;
}
.top-action {
    position: absolute;
    top: 8%;
    height: 84%;
    min-height: 36dp;
    font-size: 12dp;
    font-weight: 700;
}
.top-menu-button {
    color: #f2f8dd;
}
#hud\.satellite {
    right: 90dp;
    width: 72dp;
}
#hud\.menu {
    right: 12dp;
    width: 72dp;
}
.power-resource {
    height: 100%;
    padding: 0 .55vw;
    background-color: #07171e;
    border: 1dp #249bb7;
    color: #dff8ff;
    font-size: 12dp;
    font-weight: 700;
}
.power-resource:hover, .power-resource:focus {
    background-color: #12323b;
    border-color: #54d7f2;
    outline: 1dp #54d7f2;
}
#power-panel {
    position: absolute;
    left: 1%;
    top: 56dp;
    width: 560dp;
    max-width: 70%;
    height: 220dp;
    max-height: 38%;
    pointer-events: auto;
}
#power-content {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 12%;
    bottom: 12%;
    overflow: auto;
    font-size: 12dp;
}
#power-content h2 {
    margin: 0 0 .7vh;
    color: #43c9e5;
    font-size: 18dp;
}
.power-summary {
    margin-bottom: .4vh;
    color: #dce9e4;
}
.power-device {
    height: 20dp;
    min-height: 20dp;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: #efbf56;
}
#alerts {
    position: absolute;
    left: 50%;
    top: 8.5%;
    width: 36%;
    margin-left: -18%;
    text-align: center;
}
.alert {
    margin-bottom: 5dp;
    padding: 7dp 14dp;
    background-color: #160c09e8;
    border: 1dp #d27239;
    color: #ffe4c4;
    font-size: 13dp;
}
#minimap-shell {
    position: absolute;
    right: 1%;
    top: 56dp;
    width: 22vh;
    height: 22vh;
    min-width: 160dp;
    min-height: 160dp;
    pointer-events: auto;
}
#minimap-content {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 10%;
    bottom: 10%;
    overflow: hidden;
}
#minimap-frame {
    position: absolute;
    width: 100%;
    height: 100%;
    pointer-events: none;
}
#entity-shell {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 800dp;
    max-width: 98%;
    height: 350dp;
    max-height: 48%;
    pointer-events: auto;
}
.entity-actions-art {
    left: 0;
    bottom: 0;
    width: 49%;
    height: 100%;
}
.entity-info-art {
    left: 51%;
    bottom: 0;
    width: 49%;
    height: 100%;
}
#entity-shell.hidden,#power-panel.hidden { display: none; }
#entity-shell.info-only { width: 392dp; max-width: 49%; }
.info-only .entity-actions-art, .info-only .entity-actions { display: none; }
.info-only .entity-info-art { left: 0; width: 100%; }
.info-only .entity-info { left: 8%; right: 8%; }
#entity-content {
    position: absolute;
    left: 0;
    right: 0;
    top: 12%;
    bottom: 9%;
}
.entity-info {
    position: absolute;
    left: 55%;
    right: 4%;
    top: 0;
    bottom: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: auto;
}
.entity-title {
    flex-shrink: 0;
    height: 2.5vh;
    min-height: 27dp;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: #fff4c2;
    font-size: 14dp;
    font-weight: 700;
}
.entity-main {
    display: flex;
    gap: 8dp;
    flex-shrink: 0;
    align-items: flex-start;
}
.portrait {
    width: 52dp;
    height: 52dp;
    flex: 0 0 52dp;
    object-fit: contain;
}
.bars-stats {
    flex: 1;
    min-width: 0;
    overflow: hidden;
}
.hud-bar {
    height: 1.65vh;
    min-height: 18dp;
    margin-bottom: .55vh;
}
.hud-bar .progress-label {
    font-size: 11dp;
}
.stats-list {
    flex-shrink: 0;
    margin-top: .65vh;
    border-top: 1dp #285765;
    padding-top: .45vh;
    overflow: hidden;
}
.stat {
    width: 100%;
    min-height: 1.55vh;
    display: flex;
    justify-content: space-between;
    gap: 4%;
    font-size: 12dp;
    line-height: 17dp;
}
.stat-label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #a9c4c9;
    white-space: nowrap;
}
.stat-value {
    flex: 0 0 auto;
    color: #f2f6df;
    text-align: right;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.entity-actions {
    position: absolute;
    left: 4%;
    right: 55%;
    top: 0;
    bottom: 0;
    overflow: auto;
}
.action-heading {
    margin: 0 0 5dp;
    color: #a9c4c9;
    font-size: 11dp;
    font-weight: 700;
}
.action-row {
    display: flex;
    gap: 6dp;
    margin-bottom: 6dp;
}
.action, .selection-group {
    position: relative;
    width: 72dp;
    height: 72dp;
    flex: 0 0 72dp;
    padding: 0;
}
.action img {
    position: absolute;
    left: 16dp;
    top: 5dp;
    width: 40dp;
    height: 40dp;
    pointer-events: none;
}
.action-name {
    position: absolute;
    left: 4dp;
    right: 4dp;
    bottom: 4dp;
    height: 22dp;
    line-height: 11dp;
    font-size: 9dp;
    text-align: center;
    overflow: hidden;
    pointer-events: none;
}
.action-hotkey {
    position: absolute;
    right: 4dp;
    top: 3dp;
    font-size: 9dp;
    background-color: #061016;
    color: #fff4c2;
    pointer-events: none;
}
.action.unavailable img { opacity: .4; }
.action.unavailable .action-name { color: #829298; }
.action.active {
    outline: 3dp #ef8736;
    image-color: #ffe0bd;
}
.action:disabled {
    image-color: #777;
    opacity: .55;
}
.tooltip {
    clip: none;
    visibility: hidden;
    position: absolute;
    left: 0;
    bottom: 100%;
    width: 260dp;
    padding: 10dp;
    background-color: #050a0df5;
    border: 2dp #43c9e5;
    color: #eef5dd;
    font-size: 11dp;
    line-height: 15dp;
    z-index: 20;
    pointer-events: none;
}
.action:hover .tooltip {
    clip: none;
    visibility: visible;
}
#entity-queue {
    position: absolute;
    left: 4%;
    bottom: 100%;
    width: 92%;
    pointer-events: auto;
}
.queue {
    min-height: 5.2vh;
    padding: .45vh .7vw;
    display: flex;
    align-items: center;
    gap: .5vw;
    background-color: #061117ee;
    border: 1dp #3199ad;
    overflow-x: auto;
    overflow-y: hidden;
}
.queue h3 {
    margin: 0 .35vw 0 0;
    color: #43c9e5;
    font-size: 12dp;
    flex-shrink: 0;
}
.queue button {
    flex-shrink: 0;
    width: 9vw;
    min-width: 150dp;
    height: 4.2vh;
    min-height: 44dp;
    display: flex;
    align-items: center;
    text-align: left;
    font-size: 12dp;
}
.queue img {
    width: 3.2vh;
    height: 3.2vh;
    min-width: 34dp;
    min-height: 34dp;
    margin-right: .35vw;
}
.selection-group {
    display: flex;
    align-items: center;
    justify-content: center;
}
.selection-group img {
    width: 70%;
    height: 70%;
}
.selection-group span {
    margin-left: 7dp;
}
.footer {
    flex-shrink: 0;
    margin-top: auto;
    padding-top: .4vh;
    color: #9ec2ca;
    font-size: 12dp;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
#placement-reason {
    position: absolute;
    width: 310dp;
    padding: 8dp 12dp;
    background-color: #160c09ee;
    border: 2dp #d95a38;
    color: #ffe4d7;
    font-size: 12dp;
}
