/* Crop the transparent top and bottom padding from the source art. */
@spritesheet common-button-art {
    src: "../textures/ui/menu_button.png";
    resolution: 1x;
    button-face: 0px 78px 2169px 522px;
}
/* Shared image-backed button component. The decorator resolves relative to this stylesheet. */
.art-button {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 11dp;
    border-width: 0;
    background-color: transparent;
    decorator: image(button-face fill);
    image-color: #cbd5d8;
    cursor: pointer;
}
.art-button .button-icon {
    position: relative;
    left: auto;
    top: auto;
    width: 36dp;
    height: 36dp;
    flex: 0 0 36dp;
    image-color: #d7edf0;
    pointer-events: none;
}
.art-button span {
    position: relative;
    pointer-events: none;
}
.art-button:hover, .art-button:focus {
    background-color: transparent;
    color: #ffffff;
    image-color: #dfffff;
}
.art-button:hover .button-icon, .art-button:focus .button-icon {
    image-color: #ffffff;
}
.art-button:active {
    image-color: #aebfc4;
}
.art-button:disabled {
    image-color: #687277;
}
