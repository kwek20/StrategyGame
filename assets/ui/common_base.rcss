/* Document defaults and decorative primitives shared by every screen. */
body {
    width: 100%;
    height: 100%;
    margin: 0;
    font-family: "Segoe UI";
    pointer-events: none;
}
.panel-art {
    position: absolute;
    width: 100%;
    height: 100%;
    pointer-events: none;
}
.panel-rule {
    height: 2dp;
    background-color: #1da6c9;
}
