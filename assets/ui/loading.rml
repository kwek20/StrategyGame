<rml>
    <head>
        <title>Loading</title>
        <link type="text/rcss" href="loading.rcss"/>
    </head>
    <body>
        <div id="loading-shell">
            <img id="loading-panel-art" src="../textures/ui/tooltip_panel.png"/>
            <div id="loading-content">
                <div id="loading-header">
                    <h1 id="loading-title">LOADING</h1>
                    <span id="loading-percentage">0%</span>
                </div>
                <div id="loading-status-row">
                    <span id="loading-status"/>
                    <span id="loading-dots">...</span>
                </div>
                <div id="loading-track">
                    <img id="loading-track-art" src="../textures/ui/loading_progress_frame.png"/>
                    <div id="loading-track-inner">
                        <div id="loading-fill">
                            <img id="loading-fill-art" src="../textures/ui/loading_progress_fill.png"/>
                            <img id="loading-lead" src="../textures/ui/loading_progress_lead.png"/>
                        </div>
                    </div>
                    <div id="loading-ticks">
                        <span/>
                        <span/>
                        <span/>
                        <span/>
                        <span/>
                        <span/>
                        <span/>
                        <span/>
                        <span/>
                        <span/>
                        <span/>
                    </div>
                </div>
            </div>
        </div>
    </body>
</rml>
