body {
    width: 100%;
    height: 100%;
    margin: 0;
    color: #f2f8dc;
    font-family: "Segoe UI";
    pointer-events: none;
}
#loading-shell {
    position: absolute;
    left: 6%;
    top: 29%;
    width: 88%;
    height: 42%;
    animation: .3s quadratic-out enter;
}
#loading-panel-art {
    position: absolute;
    width: 100%;
    height: 100%;
    image-color: #e6ecee;
}
#loading-content {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 16%;
    bottom: 15%;
    display: flex;
    flex-direction: column;
}
#loading-header {
    height: 46dp;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14dp;
}
#loading-title {
    margin: 0;
    height: 42dp;
    line-height: 42dp;
    color: #fff9d0;
    font-size: 34dp;
}
#loading-percentage {
    min-width: 58dp;
    height: 30dp;
    line-height: 30dp;
    padding: 0 8dp;
    text-align: center;
    background-color: #031017;
    border: 1dp #24586a;
    color: #f4ffff;
    font-size: 15dp;
    font-weight: 700;
}
#loading-status-row {
    height: 38dp;
    display: flex;
    align-items: center;
    color: #b9e8f5;
    font-size: 17dp;
    font-weight: 700;
}
#loading-status {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
#loading-dots {
    width: 30dp;
    margin-left: 2dp;
    animation: 1s infinite pulse;
}
#loading-track {
    position: relative;
    width: 100%;
    height: 68dp;
    margin-top: 5dp;
}
#loading-track-art {
    position: absolute;
    width: 100%;
    height: 100%;
    image-color: #eff8fa;
}
#loading-track-inner {
    position: absolute;
    left: 2.8%;
    right: 2.8%;
    top: 20%;
    height: 60%;
    overflow: hidden;
}
#loading-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 0%;
    height: 100%;
}
#loading-fill-art {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    image-color: #ffffff;
    animation: 1.1s infinite shimmer;
}
#loading-lead {
    position: absolute;
    right: 0;
    top: 0;
    width: 65dp;
    height: 100%;
    animation: .75s infinite lead-pulse;
}
#loading-ticks {
    position: absolute;
    left: 2.8%;
    right: 2.8%;
    top: 28%;
    height: 44%;
    display: flex;
    justify-content: space-between;
}
#loading-ticks span {
    width: 1dp;
    height: 100%;
    background-color: #247a94;
    opacity: .5;
}
@keyframes enter {
    from {
        opacity: 0;
        top: 32%;
    }
    to {
        opacity: 1;
        top: 29%;
    }
}
@keyframes pulse {
    0% {
        opacity: .3;
    }
    50% {
        opacity: 1;
    }
    100% {
        opacity: .3;
    }
}
@keyframes lead-pulse {
    0% {
        opacity: .68;
    }
    50% {
        opacity: 1;
    }
    100% {
        opacity: .68;
    }
}
@keyframes shimmer {
    0% {
        image-color: #b7eefa;
    }
    50% {
        image-color: #ffffff;
    }
    100% {
        image-color: #b7eefa;
    }
}
