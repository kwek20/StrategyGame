body {
    width: 100%;
    height: 100%;
    margin: 0;
    color: #f2f8dc;
    font-family: "Segoe UI";
    pointer-events: none;
}
#loading-shell {
    position: absolute;
    left: 8%;
    top: 34%;
    width: 84%;
    height: 30%;
    min-height: 230dp;
    animation: .3s quadratic-out enter;
}
#loading-panel-art {
    position: absolute;
    width: 100%;
    height: 100%;
    image-color: #e6ecee;
}
#loading-content {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 13%;
    bottom: 13%;
    display: flex;
    flex-direction: column;
}
#loading-header {
    height: 42dp;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10dp;
}
#loading-title {
    margin: 0;
    height: 36dp;
    line-height: 36dp;
    color: #fff9d0;
    font-size: 31dp;
}
#loading-header.ready #loading-title {
    animation: 1.15s infinite click-attention;
}
#loading-percentage {
    min-width: 52dp;
    height: 26dp;
    line-height: 26dp;
    padding: 0 7dp;
    text-align: center;
    background-color: #031017;
    border: 1dp #24586a;
    color: #f4ffff;
    font-size: 15dp;
    font-weight: 700;
}
#loading-status-row {
    height: 32dp;
    margin-top: 5dp;
    margin-bottom: 8dp;
    display: flex;
    align-items: center;
    color: #b9e8f5;
    font-size: 17dp;
    font-weight: 700;
}
#loading-status {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
#loading-dots {
    width: 30dp;
    margin-left: 2dp;
    animation: 1s infinite pulse;
}
#loading-track {
    position: relative;
    width: 100%;
    height: 58dp;
    margin-top: 0;
}
#loading-track-art {
    position: absolute;
    width: 100%;
    height: 100%;
    image-color: #eff8fa;
    pointer-events: none;
}
#loading-track-inner {
    position: absolute;
    left: 2.5%;
    right: 2.5%;
    top: 18%;
    height: 64%;
    overflow: hidden;
}
#loading-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    fill-image: "../textures/ui/loading_progress_energy.png";
    image-color: #9ddce5;
}
#loading-fill-lead {
    position: absolute;
    left: 0;
    top: 0;
    width: 30dp;
    height: 100%;
    margin-left: -15dp;
    image-color: #d8fbff;
    pointer-events: none;
}
@keyframes enter {
    from {
        opacity: 0;
        top: 35%;
    }
    to {
        opacity: 1;
        top: 34%;
    }
}
@keyframes pulse {
    0% {
        opacity: .3;
    }
    50% {
        opacity: 1;
    }
    100% {
        opacity: .3;
    }
}
@keyframes click-attention {
    0% {
        opacity: .58;
    }
    50% {
        opacity: 1;
    }
    100% {
        opacity: .58;
    }
}
