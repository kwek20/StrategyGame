body {
    width: 100%;
    height: 100%;
    margin: 0;
    color: #f2f8dc;
    font-family: "Segoe UI";
    pointer-events: none;
}
#loading-shell {
    position: absolute;
    left: 6%;
    top: 32%;
    width: 88%;
    height: 36%;
    animation: .3s quadratic-out enter;
}
#loading-panel-art {
    position: absolute;
    width: 100%;
    height: 100%;
    image-color: #e6ecee;
}
#loading-content {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 19%;
    bottom: 15%;
    display: flex;
    flex-direction: column;
}
#loading-header {
    height: 40dp;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10dp;
}
#loading-title {
    margin: 0;
    height: 36dp;
    line-height: 36dp;
    color: #fff9d0;
    font-size: 34dp;
}
#loading-percentage {
    min-width: 52dp;
    height: 26dp;
    line-height: 26dp;
    padding: 0 7dp;
    text-align: center;
    background-color: #031017;
    border: 1dp #24586a;
    color: #f4ffff;
    font-size: 15dp;
    font-weight: 700;
}
#loading-status-row {
    height: 32dp;
    margin-top: 3dp;
    margin-bottom: 6dp;
    display: flex;
    align-items: center;
    color: #b9e8f5;
    font-size: 17dp;
    font-weight: 700;
}
#loading-status {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
#loading-dots {
    width: 30dp;
    margin-left: 2dp;
    animation: 1s infinite pulse;
}
#loading-track {
    position: relative;
    width: 100%;
    height: 62dp;
    margin-top: 0;
}
#loading-track-art {
    position: absolute;
    width: 100%;
    height: 100%;
    image-color: #eff8fa;
}
#loading-track-inner {
    position: absolute;
    left: 2.8%;
    right: 2.8%;
    top: 24%;
    height: 52%;
    overflow: hidden;
}
#loading-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    fill-image: "../textures/ui/loading_progress_energy.png";
    image-color: #c4edf2;
}
@keyframes enter {
    from {
        opacity: 0;
        top: 35%;
    }
    to {
        opacity: 1;
        top: 32%;
    }
}
@keyframes pulse {
    0% {
        opacity: .3;
    }
    50% {
        opacity: 1;
    }
    100% {
        opacity: .3;
    }
}
