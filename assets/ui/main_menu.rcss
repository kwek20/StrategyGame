body {
    color: #f2f8d8;
}
#menu-shell {
    animation: 0.45s quadratic-out menu-enter;
}
#panel-art {
    left: 0;
    top: 0;
    image-color: #e4e9eb;
}
#menu-content {
    top: 12%;
    bottom: 13%;
}
#menu-title {
    margin: 0;
    height: auto;
    flex-shrink: 0;
    line-height: 1.1;
    margin-bottom: 12dp;
    color: #fff8c9;
    font-size: 4.4vh;
    font-weight: 700;
    letter-spacing: 1dp;
}
#title-rule {
    margin-bottom: 26dp;
}
#button-stack {
    gap: 14dp;
}
.menu-button {
    width: 96%;
    height: 16%;
    padding: 0;
    color: #edf6da;
    font-size: 3vh;
    letter-spacing: 0.5dp;
    transition: left color 0.12s quadratic-out;
}
.menu-button:hover, .menu-button:focus {
    left: 7dp;
}
.menu-button:active {
    left: 7dp;
    opacity: 0.86;
}
.primary {
    color: #edffd9;
}
.danger {
    color: #ffd8cf;
}
#version {
    position: absolute;
    right: 2.5%;
    bottom: 2.5%;
    color: #b5cbd5;
    font-size: 14dp;
    letter-spacing: 0.5dp;
}
@keyframes menu-enter {
    from {
        opacity: 0;
        left: -1.5%;
    }
    to {
        opacity: 1;
        left: 2.5%;
    }
}
@media (max-width: 900px) {
    #menu-shell {
        left: 1%;
        width: 47%;
        min-width: 360dp;
    }
    #menu-title {
        font-size: 32dp;
    }
    .menu-button {
        height: 56dp;
        font-size: 22dp;
    }
}
