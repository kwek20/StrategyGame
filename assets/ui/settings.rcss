body {
    color: #edf6da;
}
#shell {
    left: 8%;
    top: 4%;
    width: 84%;
    height: 92%;
    animation: .35s quadratic-out settings-enter;
}

h1 {
    margin: 0;
    height: 48dp;
    font-size: 34dp;
    color: #fff8c9;
}
.rule {
    margin-bottom: 14dp;
}
.columns {
    overflow: hidden;
}
.column {
    width: 48%;
}
.controls {
    width: 48%;
}
h2 {
    height: 28dp;
    margin: 3dp 0 6dp;
    color: #63d8f4;
    font-size: 20dp;
}
.setting-row {
    height: 56dp;
    min-height: 56dp;
    margin-bottom: .35vh;
    display: flex;
    flex-direction: column;
}
.label {
    height: 18dp;
    min-height: 18dp;
    margin-left: .5%;
    color: #b6ced6;
    font-size: 11dp;
    letter-spacing: .4dp;
}
.wide {
    height: 3.2vh;
    min-height: 32dp;
    width: 100%;
    color: #f2f8dd;
    font-size: 14dp;
    font-weight: 700;
}
#binding-list {
    display: flex;
    flex-direction: column;
    gap: .45vh;
}
.binding-row {
    height: auto;
    min-height: 40dp;
    display: flex;
    align-items: center;
    gap: 2%;
}
.binding-label {
    flex: 1;
    min-width: 0;
    color: #edf6da;
    font-size: 12dp;
    font-weight: 700;
    overflow: hidden;
    white-space: normal;
}
.binding {
    width: 76dp;
    min-width: 76dp;
    flex: 0 0 76dp;
    height: 3.2vh;
    min-height: 32dp;
    padding: 0 2%;
    color: #f2f8dd;
    font-size: 12dp;
    font-weight: 700;
    background-color: transparent;
    border-width: 0;
    decorator: none;
    cursor: pointer;
}
.keycap {
    width: 60dp;
    height: 22dp;
    line-height: 22dp;
    padding: 0 6dp;
    background-color: #07171e;
    border: 1dp #249bb7;
    color: #82e4f7;
    text-align: center;
    font-size: 11dp;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.binding:hover,.binding:focus {
    background-color: transparent;
    outline: 0;
}
.binding:hover .keycap,.binding:focus .keycap {
    background-color: #12323b;
    border-color: #54d7f2;
    color: #ffffff;
}
.footer {
    margin-top: 7dp;
}

@keyframes settings-enter {
    from {
        opacity: 0;
        top: 7%;
    }
    to {
        opacity: 1;
        top: 4%;
    }
}
